# Required for AI orchestration
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# LLM provider for the AI reasoning layer: "anthropic" | "openai" | "ollama"
# "ollama" = local, air-gapped, self-hosted (no data leaves your network)
LLM_PROVIDER=anthropic
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Database
POSTGRES_USER=pentest
POSTGRES_PASSWORD=pentest
POSTGRES_DB=pentest_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT - generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-real-secret-min-32-random-chars
GOOGLE_CLIENT_ID=
JWT_EXPIRE_HOURS=12

# GitHub (optional — powers 1-click fix PRs)
# GITHUB_TOKEN=ghp_...
# GITHUB_REPO=your-org/your-app
# GITHUB_BASE_BRANCH=main
DATABASE_URL=postgresql://postgres:YOUR_ACTUAL_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Metasploit RPC (Kali VM) — VM-ready (env + per-scan override via params)
# MSF_RPC_HOST=192.168.56.101
# MSF_RPC_PORT=55553
# MSF_RPC_USER=msf
# MSF_RPC_PASS=changeme
# MSF_RPC_SSL=false

# Execution mode — set false to run nmap etc natively (needs nmap installed), true to use Docker kali-tools
# USE_DOCKER=false
# DOCKER_HOST=tcp://localhost:2375
# GEMINI_MODEL=gemini-2.0-flash

# Enterprise safety doctrine (see README "Enterprise Safety Features")
# DOCKER_HARDENED=true       # cap-drop + no-new-privileges + pids-limit + read-only fs
# DOCKER_ROOTLESS=true       # run tool containers as nobody (65534), HOME=/tmp
# DOCKER_PIDS_LIMIT=256      # fork-bomb containment per container
# NMAP_MAX_TIMING=-T4        # speed governor ceiling for nmap (-T0..-T5)
# MASSCAN_MAX_RATE=1000      # packet-per-second ceiling for masscan probes
# SCANNER_IDENTITY=PentestAI-Authorized-Scan  # X-PentestAI-Authorized-Scan header + UA calling card
# AUDIT_TRAIL_DIR=./audit_trail  # hash-chained flight-recorder ledger (IST timestamps)
# APP_ENCRYPTION_KEY=        # Fernet key for BYOK secrets (generate via Fernet.generate_key())
